# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://supportnova:supportnova@localhost:5432/supportnova
REDIS_URL=redis://localhost:6379/0

# Clerk (Dashboard -> Configure -> API keys). The issuer is the "Frontend API URL".
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated e-mails that become administrators on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=

# Storage: "local" writes to .data/storage (development); "s3" = Cloudflare R2 in production.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=supportnova
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

EMBEDDING_PROVIDER=fastembed

# GenAI pipeline. Put your own key in .env only (never commit it).
# Which provider analyses complaints: anthropic (Claude) or openai. Switch with this one line.
GENAI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
# Any OpenAI model with JSON-schema structured outputs that your account can use.
OPENAI_MODEL=gpt-5-mini
# Set to false for OpenAI models that do not support reasoning effort.
OPENAI_REASONING=true
# low..max for both providers; none and minimal are OpenAI-only (faster, less reasoning).
GENAI_EFFORT=low
GENAI_MAX_ATTEMPTS=2

# --- E-mail complaints (optional) ------------------------------------------------------
# A real mailbox checked every minute by the worker; replies are sent from it.
# Gmail: turn on 2-Step Verification, create an App password (Google Account → Security →
# App passwords) and use it below. Leave empty to use only "Process an e-mail" in the console.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=VoltHaven Customer Care
# Sending: smtp (default) or brevo. Railway blocks outbound SMTP below the Pro plan, so there
# use Brevo's HTTPS API: brevo.com (free tier) -> Senders -> add and verify MAIL_USERNAME,
# then SMTP & API -> API keys. Reading still uses IMAP above.
MAIL_SEND_VIA=smtp
BREVO_API_KEY=

