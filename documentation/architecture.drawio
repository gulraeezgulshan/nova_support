<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" agent="SupportNova" version="24.7.0"><diagram id="page1" name="1 · Architecture overview"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;SupportNova — GenAI complaint intelligence for VoltHaven Electronics&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Who uses it, how complaints arrive, and every running part: web app (Vercel), API + worker + scheduler (Railway), data stores and external services. Arrows show the main calls." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2500" height="30" as="geometry"/></mxCell><mxCell id="c4" value="USERS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="280" height="1160" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;Customer&lt;/b&gt;&lt;br&gt;Shops, tracks orders,&lt;br&gt;complains (chat, form, e-mail),&lt;br&gt;adds photos/PDFs,&lt;br&gt;follows &amp;#x27;My complaints&amp;#x27;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="240" height="117" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;Staff (roles in PostgreSQL)&lt;/b&gt;&lt;br&gt;Agent — queue, status, enquiries,&lt;br&gt;  mailbox&lt;br&gt;Reviewer — manual review&lt;br&gt;Manager — analytics, reports,&lt;br&gt;  bulk import, users&lt;br&gt;Admin — knowledge base, rules,&lt;br&gt;  taxonomy, products, everything" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="240" height="168" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;Evaluator&lt;/b&gt;&lt;br&gt;Signs in with a given role,&lt;br&gt;or runs evaluation packs&lt;br&gt;(make evaluate) on hidden data" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="240" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;i&gt;Sign-in by Clerk; the role (customer, agent, reviewer, manager, admin) is stored and enforced by SupportNova, never taken from the token.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="620" width="240" height="200" as="geometry"/></mxCell><mxCell id="c9" value="INTAKE CHANNELS (SRS)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="320" height="1160" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;Web chat (shop → Get help)&lt;/b&gt;&lt;br&gt;Guided assistant asks 1 question&lt;br&gt;at a time → summary → Confirm&lt;br&gt;channel: live_chat" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="145" width="280" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;Web form — Contact us&lt;/b&gt;&lt;br&gt;Order problem → complaint&lt;br&gt;(web_form, sign-in, attachments)&lt;br&gt;Other topics → Enquiries inbox" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="265" width="280" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:13px'&gt;E-mail — support mailbox&lt;/b&gt;&lt;br&gt;Gmail: read by the worker every minute,&lt;br&gt;replies sent from the same mailbox&lt;br&gt;new mail → complaint (email)&lt;br&gt;thread reply → added to complaint&lt;br&gt;or staff: Mailbox → Process an e-mail" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="385" width="280" height="134" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px'&gt;Complaint upload — bulk&lt;/b&gt;&lt;br&gt;CSV / Excel (≤1,000 rows)&lt;br&gt;preview every row → import&lt;br&gt;source: upload" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="525" width="280" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:13px'&gt;Portal form / staff entry&lt;/b&gt;&lt;br&gt;Customer: Submit a complaint&lt;br&gt;Staff: on behalf of a customer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="645" width="280" height="83" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:13px'&gt;Datasets &amp;amp; evaluation packs (CLI)&lt;/b&gt;&lt;br&gt;536 labelled complaints&lt;br&gt;109-complaint hold-out pack&lt;br&gt;load_dataset / make evaluate" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="745" width="280" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;i&gt;Every channel ends in the same intake function &lt;b&gt;submit_complaint&lt;/b&gt;: same checks, same pipelines, same audit trail.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="360" y="865" width="280" height="120" as="geometry"/></mxCell><mxCell id="c17" value="WEB APP — Next.js 16 on Vercel  (web/)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="420" height="1160" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;Public VoltHaven shop  (route group (shop))&lt;/b&gt;&lt;br&gt;Home, Shop (search, filters, sort, best sellers), Product,&lt;br&gt;Cart, Checkout, My orders (timeline, Get help),&lt;br&gt;Contact us, Help centre (FAQ), Shipping, Returns, Warranty,&lt;br&gt;Privacy, Terms, About, About SupportNova, 404&lt;br&gt;Support chat panel on every page&lt;br&gt;Policy numbers come from GET /storefront/config" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="145" width="380" height="151" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;Staff console  (route group (app))&lt;/b&gt;&lt;br&gt;Dashboard (KPIs, charts, SLA risk)&lt;br&gt;Complaints queue + complaint page: AI analysis, Python&lt;br&gt;  validation, GenAI vs Python, chat transcript,&lt;br&gt;  supporting documents, status, review panel&lt;br&gt;Manual review queue · Analytics · Reports (CSV/XLSX/PDF)&lt;br&gt;Knowledge base (upload, versions, chunks, search)&lt;br&gt;Rules (rule matrix) · Taxonomy &amp;amp; SLAs · Products&lt;br&gt;Enquiries · Mailbox · Import complaints · Users &amp;amp; roles" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="335" width="380" height="185" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style='font-size:13px'&gt;Shared web layer&lt;/b&gt;&lt;br&gt;Clerk (sign-in, session token on every request)&lt;br&gt;Typed API client generated from OpenAPI (hey-api)&lt;br&gt;TanStack Query (cache, polling) · shadcn/ui · motion&lt;br&gt;proxy.ts: public shop pages, protected console&lt;br&gt;→ calls the API over HTTPS with the Clerk token" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="555" width="380" height="134" as="geometry"/></mxCell><mxCell id="c21" value="API — FastAPI on Railway  (service: api)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="100" width="500" height="1160" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style='font-size:13px'&gt;REST API  /api/v1  (routers)&lt;/b&gt;&lt;br&gt;complaints · review · chat · contact/enquiries · attachments&lt;br&gt;documents (knowledge base) · rules · taxonomy · users&lt;br&gt;analytics &amp;amp; reports · storefront (products, checkout, orders)&lt;br&gt;mailbox · imports · webhooks (Clerk) · health (/healthz, /readyz)&lt;br&gt;Reads/writes PostgreSQL; files to R2; queues tasks in Redis" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="145" width="460" height="134" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:13px'&gt;Security layer&lt;/b&gt;&lt;br&gt;Clerk JWT (RS256) verified with JWKS; users upserted&lt;br&gt;RBAC: require_roles(...) per endpoint; customers see only&lt;br&gt;  their own data (404 otherwise); CORS to the web origin only&lt;br&gt;Every change written to audit_events (append-only)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="290" width="460" height="117" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style='font-size:13px'&gt;Complaint intake  (complaint_processing)&lt;/b&gt;&lt;br&gt;Sanitise text (hidden Unicode), redact card numbers,&lt;br&gt;  passwords, ID numbers — before anything is stored&lt;br&gt;Validate fields, order ownership, channel; title/description&lt;br&gt;Exact duplicate (hash) → 409; near-duplicate (embeddings) → link&lt;br&gt;Risk signals: 14 detector lexicons (safety, legal, privacy,&lt;br&gt;  injection, repeat contact…) · entities (amounts, dates, refs)&lt;br&gt;Stores complaint (status new) → task to the worker (via Redis)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="435" width="460" height="168" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style='font-size:13px'&gt;Knowledge base  (knowledge_base)&lt;/b&gt;&lt;br&gt;Upload PDF/DOCX → validate (type by content, size, metadata)&lt;br&gt;Parse sections &amp;amp; pages → chunk → embed → store (see page 3)&lt;br&gt;Versions: draft → active → superseded/expired; precedence&lt;br&gt;Hybrid search (vector + keyword) for Pipeline 1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="645" width="460" height="117" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style='font-size:13px'&gt;Other services&lt;/b&gt;&lt;br&gt;Support chat (support_chat) · Contact &amp;amp; enquiries&lt;br&gt;E-mail channel processing (email_channel) · Bulk import&lt;br&gt;Storefront (catalogue, checkout, orders, product images)&lt;br&gt;Analytics &amp;amp; 9 reports · SLA tracking · Review workflow" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="790" width="460" height="117" as="geometry"/></mxCell><mxCell id="c27" value="BACKGROUND — Celery  (worker + beat)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1670" y="100" width="470" height="1160" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style='font-size:13px'&gt;Worker (celery worker, queues default / ingest / analysis)&lt;/b&gt;&lt;br&gt;process_complaint → Pipeline 1, then Pipeline 2&lt;br&gt;ingest_document → parse, chunk, embed a policy version&lt;br&gt;check_mailbox → read new e-mails, file or append&lt;br&gt;flush_outbox → send queued e-mails (3 tries, back-off)&lt;br&gt;run_import → bulk upload rows through the intake" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="145" width="430" height="134" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style='font-size:13px'&gt;Beat (scheduler, exactly one instance)&lt;/b&gt;&lt;br&gt;SLA risk scan — every 5 min (at-risk / breached alerts)&lt;br&gt;Mailbox check — every 1 min (PostgreSQL advisory lock)&lt;br&gt;E-mail outbox — every 30 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="700" width="430" height="100" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style='font-size:13px'&gt;Pipeline 1 — GenAI analysis  (genai_pipeline)&lt;/b&gt;&lt;br&gt;Hybrid retrieval of active policy passages (RAG)&lt;br&gt;Prompt v1.2.0: complaint (untrusted), customer, order,&lt;br&gt;  facts, history, policies, supporting documents&lt;br&gt;Claude or OpenAI → strict JSON schema → 1 repair retry&lt;br&gt;Output: category, sentiment, urgency, priority, departments,&lt;br&gt;  escalation, resolution steps, customer reply, follow-up,&lt;br&gt;  cited policy chunks  → analysis_runs + llm_calls" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="300" width="430" height="168" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b style='font-size:13px'&gt;Pipeline 2 — Python ground truth  (python_validation)&lt;/b&gt;&lt;br&gt;Rule engine: 111 rules (rule matrix) decide department,&lt;br&gt;  urgency, priority, escalation, required/blocked actions&lt;br&gt;16 checks: schema, category, department, escalation,&lt;br&gt;  actions, compensation cap, policy versions &amp;amp; precedence,&lt;br&gt;  hallucination, promises, injection, contradictions,&lt;br&gt;  missing info, follow-up, evidence …&lt;br&gt;Verdict: verified / corrected / needs_review&lt;br&gt;GenAI vs Python comparison → review task if needed&lt;br&gt;Reply queued → chat or e-mail (outbox)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="490" width="430" height="202" as="geometry"/></mxCell><mxCell id="c32" value="DATA &amp;amp; EXTERNAL SERVICES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2170" y="100" width="400" height="1160" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b style='font-size:13px'&gt;PostgreSQL 18 + pgvector  (Railway)&lt;/b&gt;&lt;br&gt;Complaints: customers, orders, complaints, events&lt;br&gt;Analysis: prompt_versions, analysis_runs, llm_calls&lt;br&gt;Validation: rules, validation_runs, review_tasks,&lt;br&gt;  reviewer_decisions&lt;br&gt;Knowledge: documents, document_versions, chunks&lt;br&gt;  (vector(384) + tsvector)&lt;br&gt;Channels: chat_*, inbound/outbound_emails, enquiries,&lt;br&gt;  complaint_attachments, import_batches&lt;br&gt;Shop: products, product_images · Org: users, taxonomy,&lt;br&gt;  departments, sla_policies · audit_events" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="145" width="360" height="219" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style='font-size:13px'&gt;Redis  (Railway)&lt;/b&gt;&lt;br&gt;Celery message broker (task queue)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="710" width="360" height="66" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style='font-size:13px'&gt;GenAI provider (one setting)&lt;/b&gt;&lt;br&gt;Anthropic Claude (claude-opus-5) or&lt;br&gt;OpenAI (gpt-5-mini, Responses API)&lt;br&gt;structured JSON output" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="385" width="360" height="100" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b style='font-size:13px'&gt;Support mailbox (e.g. Gmail)&lt;/b&gt;&lt;br&gt;IMAP 993 read · SMTP 465 send (by the worker)&lt;br&gt;App password in environment only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="505" width="360" height="83" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b style='font-size:13px'&gt;Cloudflare R2 (S3-compatible storage)&lt;/b&gt;&lt;br&gt;Policy files, complaint attachments,&lt;br&gt;product images (local disk in dev)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="800" width="360" height="83" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b style='font-size:13px'&gt;Clerk&lt;/b&gt;&lt;br&gt;Sign-in UI, sessions, JWT (RS256)&lt;br&gt;Webhook → API: user created/updated/deleted" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="900" width="360" height="83" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b style='font-size:13px'&gt;Embeddings (in-process)&lt;/b&gt;&lt;br&gt;fastembed BAAI/bge-small-en-v1.5&lt;br&gt;384 dims, runs inside api/worker, no API cost" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="1000" width="360" height="83" as="geometry"/></mxCell><mxCell id="c40" value="&lt;i&gt;The API and the worker both read/write PostgreSQL and R2; the web app talks only to the API (and Clerk for sign-in).&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="2190" y="1110" width="360" height="120" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d7d2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2d7d2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c28" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c30" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c31" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c29" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="KEY NUMBERS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="1290" width="2540" height="190" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Taxonomy&lt;/b&gt;: 12 categories · 38 subcategories · 10 departments · 4 SLA priorities (P0–P3) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;Rules&lt;/b&gt;: 111-rule Complaint Resolution Rule Matrix · 54 controlled action codes &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;Knowledge base&lt;/b&gt;: 20 policy documents &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;Data&lt;/b&gt;: 536 labelled complaints + 109 hold-out &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;Reports&lt;/b&gt;: 9 (CSV / Excel / PDF)&lt;br&gt;&lt;b&gt;Quality&lt;/b&gt;: 432 automated backend tests (pytest on real PostgreSQL) · ruff · mypy --strict · ESLint · TypeScript · next build · gitleaks in CI&lt;br&gt;&lt;br&gt;&lt;b&gt;Colours&lt;/b&gt;: &lt;span style='background:#dae8fc'&gt;&amp;nbsp;channels&amp;nbsp;&lt;/span&gt; &lt;span style='background:#d5e8d4'&gt;&amp;nbsp;web app&amp;nbsp;&lt;/span&gt; &lt;span style='background:#fff2cc'&gt;&amp;nbsp;API&amp;nbsp;&lt;/span&gt; &lt;span style='background:#e1d5e7'&gt;&amp;nbsp;background &amp;amp; pipelines&amp;nbsp;&lt;/span&gt; &lt;span style='background:#f8cecc'&gt;&amp;nbsp;data&amp;nbsp;&lt;/span&gt; &lt;span style='background:#ffe6cc'&gt;&amp;nbsp;external services&amp;nbsp;&lt;/span&gt; &amp;nbsp; — solid arrow: request/data flow · dashed: asynchronous or external" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="1325" width="2500" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 · Complaint lifecycle"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;How one complaint is handled — from intake to reply&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="The GenAI model proposes; Python decides. Both results are kept, compared and auditable." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2500" height="30" as="geometry"/></mxCell><mxCell id="c4" value="A · INTAKE  (API, synchronous — the customer gets a reference immediately)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="2540" height="260" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;1. Complaint arrives&lt;/b&gt;&lt;br&gt;chat · web form · e-mail · bulk upload&lt;br&gt;· portal · dataset/evaluation pack" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="280" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;2. Clean &amp;amp; protect&lt;/b&gt;&lt;br&gt;Sanitise hidden characters&lt;br&gt;Redact card numbers, passwords, IDs&lt;br&gt;Neutralise prompt-injection tags later&lt;br&gt;(text is always untrusted)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="145" width="330" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;3. Validate&lt;/b&gt;&lt;br&gt;Title ≥ 5 chars, description ≥ 20 chars/5 words&lt;br&gt;Order must belong to this customer&lt;br&gt;Known channel · attachments: JPG/PNG/&lt;br&gt;WebP/PDF by content, ≤5 MB, ≤5 files" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="145" width="330" height="110" as="geometry"/></mxCell><mxCell id="c8" value="Duplicate?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="140" width="170" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;4. Enrich&lt;/b&gt;&lt;br&gt;Risk signals (safety, injury, privacy,&lt;br&gt;legal, account takeover, injection…)&lt;br&gt;Entities: amounts, dates, order refs&lt;br&gt;Near-duplicate / related complaint link" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="145" width="330" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;5. Store &amp;amp; queue&lt;/b&gt;&lt;br&gt;Complaint CMP-000123, status NEW&lt;br&gt;Timeline event + audit event&lt;br&gt;Acknowledgement (chat / e-mail)&lt;br&gt;Task → Redis → worker" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="145" width="300" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;409: already filed as CMP-…&lt;/b&gt;&lt;br&gt;(e-mail: &amp;#x27;duplicate&amp;#x27; answer)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="285" width="280" height="60" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="exact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="B · PIPELINE 1 — GenAI analysis  (worker)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="2540" height="250" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;6. Retrieve policies (RAG)&lt;/b&gt;&lt;br&gt;Query from title + description&lt;br&gt;Hybrid: pgvector cosine + full-text&lt;br&gt;Reciprocal-rank fusion, top 8&lt;br&gt;Only ACTIVE document versions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="435" width="300" height="115" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style='font-size:13px'&gt;7. Build prompt (versioned YAML)&lt;/b&gt;&lt;br&gt;Taxonomy &amp;amp; action vocabulary&lt;br&gt;Customer type, verified order, facts&lt;br&gt;(days late, amounts), complaint history&lt;br&gt;Policy passages with chunk codes&lt;br&gt;Supporting documents: &amp;#x27;2 photos, 1 PDF&amp;#x27;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="435" width="340" height="115" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style='font-size:13px'&gt;8. Call the model&lt;/b&gt;&lt;br&gt;Claude or OpenAI (GENAI_PROVIDER)&lt;br&gt;Structured output: JSON schema&lt;br&gt;generated from the taxonomy&lt;br&gt;Every call logged (llm_calls)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="435" width="300" height="115" as="geometry"/></mxCell><mxCell id="c22" value="Valid JSON &amp;amp; codes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1110" y="430" width="180" height="125" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:13px'&gt;9. Analysis stored&lt;/b&gt;&lt;br&gt;Category/subcategory, sentiment, urgency,&lt;br&gt;priority, main &amp;amp; supporting departments,&lt;br&gt;escalation level, resolution steps,&lt;br&gt;customer reply, follow-up, citations" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="435" width="330" height="115" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style='font-size:13px'&gt;Retry once with the errors → still invalid: manual review&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="575" width="360" height="45" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style='font-size:13px'&gt;Provider down?&lt;/b&gt;&lt;br&gt;Task retried with back-off; meanwhile&lt;br&gt;Pipeline 2 still applies the rules, so a&lt;br&gt;safety complaint is escalated anyway" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="435" width="330" height="115" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="outage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="C · PIPELINE 2 — Python ground-truth validation  (worker, no AI involved)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="2540" height="290" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style='font-size:13px'&gt;10. Python decides on its own&lt;/b&gt;&lt;br&gt;Keyword/signal classifier&lt;br&gt;Rule matrix (111 rules): department,&lt;br&gt;urgency, priority, escalation level,&lt;br&gt;required &amp;amp; blocked actions, follow-up,&lt;br&gt;compensation limits" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="715" width="330" height="130" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style='font-size:13px'&gt;11. 16 checks on the GenAI answer&lt;/b&gt;&lt;br&gt;schema · category · subcategory · department ·&lt;br&gt;supporting departments · escalation · required actions ·&lt;br&gt;prohibited actions · compensation cap · policy (active&lt;br&gt;version, precedence) · hallucination (untraceable facts) ·&lt;br&gt;promises (refunds/dates) · injection · contradictions ·&lt;br&gt;missing information · follow-up · evidence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="715" width="420" height="130" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b style='font-size:13px'&gt;12. Score &amp;amp; correct&lt;/b&gt;&lt;br&gt;Weighted score by severity&lt;br&gt;Correctable items fixed by Python&lt;br&gt;(e.g. raise priority to rule minimum,&lt;br&gt;add mandatory action)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="715" width="300" height="130" as="geometry"/></mxCell><mxCell id="c37" value="Verdict" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="715" width="200" height="130" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b style='font-size:13px'&gt;VERIFIED&lt;/b&gt;&lt;br&gt;all checks pass" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="700" width="250" height="55" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b style='font-size:13px'&gt;CORRECTED&lt;/b&gt;&lt;br&gt;Python enforced rule values" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="765" width="250" height="55" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b style='font-size:13px'&gt;NEEDS REVIEW&lt;/b&gt;&lt;br&gt;failed check, low score, safety…" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="830" width="250" height="55" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b style='font-size:13px'&gt;13. GenAI vs Python comparison&lt;/b&gt;&lt;br&gt;Field by field: agree / disagree&lt;br&gt;Python keeps the more severe&lt;br&gt;escalation; reasons recorded&lt;br&gt;(Comparison report, evaluation metrics)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1760" y="715" width="360" height="130" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c38" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="D · OUTCOME, FOLLOW-UP &amp;amp; REPORTING" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="990" width="2540" height="330" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b style='font-size:13px'&gt;14a. Auto reply (verified / corrected)&lt;/b&gt;&lt;br&gt;The grounded customer reply is sent back&lt;br&gt;through the channel it came from:&lt;br&gt;chat message or e-mail in the same thread&lt;br&gt;(sent once; never before validation)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="1035" width="380" height="120" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b style='font-size:13px'&gt;14b. Manual review queue (needs review)&lt;/b&gt;&lt;br&gt;Customer gets a holding message&lt;br&gt;Reviewer: approve · modify · reject · regenerate ·&lt;br&gt;reclassify · reassign · escalate · comment&lt;br&gt;Original AI + Python results stay; decision logged&lt;br&gt;Approved reply → chat / e-mail" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1035" width="400" height="120" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b style='font-size:13px'&gt;15. Handling &amp;amp; timeline&lt;/b&gt;&lt;br&gt;Status: new → analyzed → assigned →&lt;br&gt;in progress → awaiting customer →&lt;br&gt;escalated → resolved → closed (→ reopened)&lt;br&gt;Customer sees the timeline in My complaints" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="1035" width="360" height="120" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b style='font-size:13px'&gt;16. SLA tracking (beat, every 5 min)&lt;/b&gt;&lt;br&gt;First-response &amp;amp; resolution due times&lt;br&gt;per priority (P0–P3) → on track /&lt;br&gt;at risk / breached alerts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="1035" width="330" height="120" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b style='font-size:13px'&gt;17. Dashboards, analytics &amp;amp; 9 reports&lt;/b&gt;&lt;br&gt;KPIs, distributions, trends, repeat complaints,&lt;br&gt;department performance, escalations, SLA status,&lt;br&gt;policy usage, resolution compliance, GenAI vs&lt;br&gt;Python, manual reviews → CSV / Excel / PDF" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1680" y="1035" width="420" height="120" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b style='font-size:13px'&gt;Policy update impact&lt;/b&gt;&lt;br&gt;When a policy document gets a new active version, complaints that cited the old one are flagged for re-validation." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="1185" width="790" height="60" as="geometry"/></mxCell><mxCell id="c59" value="verified / corrected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c41" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c60" value="needs review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c41" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3 · Knowledge base &amp; RAG"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Knowledge base and retrieval (RAG) — how policies ground every answer&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Built on PostgreSQL + pgvector with in-process embeddings; no LangChain needed. Python verifies every citation afterwards." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2500" height="30" as="geometry"/></mxCell><mxCell id="c4" value="INGESTION  (administrator uploads a document; worker processes it)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="2540" height="300" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;1. Upload (admin)&lt;/b&gt;&lt;br&gt;PDF / DOCX (+ Markdown sources)&lt;br&gt;Metadata: document ID, type,&lt;br&gt;version, effective &amp;amp; expiry dates,&lt;br&gt;owner, precedence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="290" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;2. Validate&lt;/b&gt;&lt;br&gt;Type by content (magic bytes)&lt;br&gt;Size limit, empty/corrupt files&lt;br&gt;Duplicate file or version → 409&lt;br&gt;Quarantine instruction-like text" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="290" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;3. Parse&lt;/b&gt;&lt;br&gt;Sections from headings/styles&lt;br&gt;Page numbers kept&lt;br&gt;Ligatures and labels fixed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="150" width="290" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;4. Chunk&lt;/b&gt;&lt;br&gt;Section-aware, ≤450 tokens,&lt;br&gt;60-token overlap&lt;br&gt;Code e.g. DEL-POL-04-S5.2&lt;br&gt;+ document, version, section, page" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="290" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;5. Embed &amp;amp; index&lt;/b&gt;&lt;br&gt;fastembed bge-small-en-v1.5&lt;br&gt;→ vector(384) in pgvector&lt;br&gt;+ PostgreSQL full-text tsvector" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="150" width="290" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;6. Version lifecycle&lt;/b&gt;&lt;br&gt;draft → ACTIVE → superseded / expired&lt;br&gt;Only one active version per document&lt;br&gt;New active version → flags complaints&lt;br&gt;that cited the previous one" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="150" width="360" height="120" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="RETRIEVAL  (Pipeline 1, per complaint)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="2540" height="300" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:13px'&gt;Query&lt;/b&gt;&lt;br&gt;Complaint title + description&lt;br&gt;(+ category hints)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="480" width="300" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;Semantic search&lt;/b&gt;&lt;br&gt;Embed the query (same model)&lt;br&gt;ORDER BY cosine distance&lt;br&gt;(pgvector)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="330" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;Keyword search&lt;/b&gt;&lt;br&gt;websearch/OR tsquery&lt;br&gt;ORDER BY ts_rank_cd&lt;br&gt;(PostgreSQL full-text)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="570" width="330" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style='font-size:13px'&gt;Reciprocal-rank fusion&lt;/b&gt;&lt;br&gt;Merge both rankings&lt;br&gt;Keep top 8 passages&lt;br&gt;Only ACTIVE versions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="480" width="300" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style='font-size:13px'&gt;Into the prompt&lt;/b&gt;&lt;br&gt;Each passage wrapped as untrusted text&lt;br&gt;with its chunk code, document,&lt;br&gt;version, section and page" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="480" width="330" height="110" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style='font-size:13px'&gt;Model cites chunk codes&lt;/b&gt;&lt;br&gt;policy_references in the JSON&lt;br&gt;must come from the retrieved set&lt;br&gt;(schema check, retry if not)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="480" width="330" height="110" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:13px'&gt;Python verifies (Pipeline 2)&lt;/b&gt;&lt;br&gt;Citation exists &amp;amp; was retrieved&lt;br&gt;Version active on complaint date&lt;br&gt;Precedence: policy &amp;gt; SOP &amp;gt; FAQ&lt;br&gt;Facts &amp;amp; promises traceable to sources" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1890" y="480" width="360" height="110" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="same index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="WHY THIS DESIGN" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="2540" height="170" as="geometry"/></mxCell><mxCell id="c33" value="• One database for complaints, rules and vectors → transactions, version filtering and joins in plain SQL (instead of a separate FAISS/ChromaDB store).&lt;br&gt;• Hybrid search catches both meaning (&quot;parcel never came&quot; ≈ lost parcel) and exact terms (policy IDs, product names).&lt;br&gt;• Embeddings run locally (no per-call cost, no data sent out for retrieval).&lt;br&gt;• SRS 'Semantic Retrieval: FAISS, ChromaDB, embeddings, or another suitable Python-based retrieval mechanism' → satisfied with pgvector + fastembed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="795" width="2500" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4 · Deployment, CI &amp; security"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Deployment, continuous integration and security controls&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=26;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Production: Vercel (web) + Railway (api, worker, beat, PostgreSQL/pgvector, Redis) + Cloudflare R2 + Clerk + GenAI provider + support mailbox." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2500" height="30" as="geometry"/></mxCell><mxCell id="c4" value="PRODUCTION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="1500" height="600" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:13px'&gt;Vercel — web&lt;/b&gt;&lt;br&gt;Next.js 16, root directory web/&lt;br&gt;Node 24, pnpm 12 (install/build&lt;br&gt;  commands pinned)&lt;br&gt;NEXT_PUBLIC_API_URL = api domain&lt;br&gt;Clerk keys · calls api over HTTPS + token" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="330" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:13px'&gt;Railway — api&lt;/b&gt;&lt;br&gt;Dockerfile image (Python 3.13, uv)&lt;br&gt;Pre-deploy: alembic upgrade head&lt;br&gt;Health check /readyz · PORT 8080&lt;br&gt;Public domain *.up.railway.app" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="330" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:13px'&gt;Railway — worker&lt;/b&gt;&lt;br&gt;celery worker -Q default,ingest,analysis&lt;br&gt;same image, no public domain&lt;br&gt;uses pgvector, Redis, R2, GenAI API, Gmail" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="310" width="330" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:13px'&gt;Railway — beat&lt;/b&gt;&lt;br&gt;celery beat (1 replica) → tasks via Redis&lt;br&gt;SLA 5 min · mailbox 1 min · outbox 30 s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="425" width="330" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:13px'&gt;Railway — pgvector&lt;/b&gt;&lt;br&gt;PostgreSQL + vector extension&lt;br&gt;DATABASE_URL_PRIVATE (internal)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="300" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:13px'&gt;Railway — Redis&lt;/b&gt;&lt;br&gt;Celery broker (REDIS_URL)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="250" width="300" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13px'&gt;Cloudflare R2&lt;/b&gt;&lt;br&gt;STORAGE_BACKEND=s3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="330" width="300" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:13px'&gt;Clerk&lt;/b&gt;&lt;br&gt;Sign-in for the web app · JWT&lt;br&gt;Webhook → api /api/v1/webhooks/clerk" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="270" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px'&gt;OpenAI / Anthropic&lt;/b&gt;&lt;br&gt;called by the worker (Pipeline 1)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="250" width="270" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:13px'&gt;Gmail (support mailbox)&lt;/b&gt;&lt;br&gt;IMAP/SMTP by the worker · MAIL_*" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="270" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Configuration&lt;/b&gt;: all secrets are environment variables (Railway shared variables, Vercel env) — never in Git. The API refuses to start in production without a real Clerk issuer, a non-localhost CORS origin and object storage.&lt;br&gt;&lt;b&gt;Data load&lt;/b&gt; (once): &lt;code&gt;python -m database.bootstrap --with-holdout&lt;/code&gt; → taxonomy, 111 rules, 20 policies, 536 + 109 complaints.&lt;br&gt;&lt;b&gt;Local development&lt;/b&gt;: docker compose (PostgreSQL + pgvector, Redis) · make api · make worker · make web · make test." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="1440" height="170" as="geometry"/></mxCell><mxCell id="c20" value="CONTINUOUS INTEGRATION (GitHub Actions, every push)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1560" y="100" width="1010" height="200" as="geometry"/></mxCell><mxCell id="c21" value="• &lt;b&gt;Backend&lt;/b&gt;: ruff (lint + format) · mypy --strict · pytest — 432 tests against a real PostgreSQL + pgvector service&lt;br&gt;&amp;nbsp;&amp;nbsp;unit (parsers, rules, checks, e-mail parsing, file reader) · integration (API, pipelines with a scripted GenAI provider,&lt;br&gt;&amp;nbsp;&amp;nbsp;chat, e-mail with fake IMAP/SMTP, bulk import, attachments) · security (adversarial suite)&lt;br&gt;• &lt;b&gt;Frontend&lt;/b&gt;: ESLint · TypeScript · production build&lt;br&gt;• &lt;b&gt;Secrets&lt;/b&gt;: gitleaks scan&lt;br&gt;• &lt;b&gt;Live GenAI&lt;/b&gt;: make evaluate / final-evidence (hold-out pack, metrics, comparison report)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1580" y="140" width="970" height="150" as="geometry"/></mxCell><mxCell id="c22" value="SECURITY CONTROLS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=16;fontStyle=1;dashed=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1560" y="320" width="1010" height="380" as="geometry"/></mxCell><mxCell id="c23" value="• &lt;b&gt;Prompt injection&lt;/b&gt;: complaint, e-mail, file and document text is data — escaped in XML-style tags, detected by lexicons, and Python (not the model) makes every decision.&lt;br&gt;• &lt;b&gt;Personal data&lt;/b&gt;: card numbers, passwords/PINs and ID numbers redacted at intake; attachments owner-or-staff only.&lt;br&gt;• &lt;b&gt;Access&lt;/b&gt;: Clerk RS256 tokens; roles in PostgreSQL; per-endpoint role checks; customers get 404 for others' data.&lt;br&gt;• &lt;b&gt;Hallucinations &amp;amp; promises&lt;/b&gt;: untraceable facts, invented policy IDs and unapproved refunds/dates fail validation.&lt;br&gt;• &lt;b&gt;Compensation&lt;/b&gt;: amounts above policy caps or not allowed by the rules are blocked.&lt;br&gt;• &lt;b&gt;Files&lt;/b&gt;: type by content, size limits, sanitised names, downloads as attachments with nosniff.&lt;br&gt;• &lt;b&gt;E-mail&lt;/b&gt;: auto-replies/bounces ignored, our notices marked Auto-Submitted (no mail loops), replies only to the sender.&lt;br&gt;• &lt;b&gt;Spreadsheets&lt;/b&gt;: result files neutralise formulas (=, +, -, @).&lt;br&gt;• &lt;b&gt;Audit&lt;/b&gt;: rules, documents, reviews, status changes, uploads, imports and SLA alerts in audit_events." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1580" y="360" width="970" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>