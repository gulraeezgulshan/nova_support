# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://supportnova:supportnova@localhost:5432/supportnova
REDIS_URL=redis://localhost:6379/0

# Clerk (Dashboard -> Configure -> API keys). The issuer is the "Frontend API URL".
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated e-mails that become administrators on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=

# Storage: "local" writes to .data/storage (development); "s3" = Cloudflare R2 in production.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=supportnova
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

EMBEDDING_PROVIDER=fastembed

# Used by the GenAI pipeline from Day 2.
ANTHROPIC_API_KEY=
